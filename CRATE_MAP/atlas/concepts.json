  "sources": [
    {
      "id": "S01",
      "title": "Library of Congress · Olney Hymns, 1779",
      "url": "https://www.loc.gov/item/2006700069/",
      "kind": "Digitised original / catalogue",
      "finding": "A printed hymn-text book without music; a concrete reference for the 1773 text-history stop, with the later publication date kept visible.",
      "checked": "2026-10-29"
    },
    {
      "id": "S02",
      "title": "Library of Congress · Amazing Grace and shape-note singing",
      "url": "https://www.loc.gov/collections/amazing-grace/articles-and-essays/amazing-grace-and-shape-note-singing/",
      "kind": "Collection essay",
      "finding": "Distinctive note-head shapes provided a teaching aid. A useful visual language for the 1835 notation stop; the search index supplied the essay, while a direct fetch returned 403.",
      "checked": "2026-10-29"
    },
    {
      "id": "S03",
      "title": "Library of Congress · The daguerreotype medium",
      "url": "https://www.loc.gov/pictures/collection/dag/medium.html",
      "kind": "Collection process history",
      "finding": "Publicly announced in France in 1839; a detailed image on silver-plated copper, rather than a universally brown, grainy print.",
      "checked": "2026-10-29"
    },
    {
      "id": "S04",
      "title": "Library of Congress · Brady-Handy collection",
      "url": "https://www.loc.gov/collections/brady-handy/about-this-collection/",
      "kind": "Collection essay",
      "finding": "Mounted cartes de visite, wet plates and later dry plates offer distinct nineteenth-century reference formats.",
      "checked": "2026-10-29"
    },
    {
      "id": "S05",
      "title": "National Science and Media Museum · Autochrome",
      "url": "https://blog.scienceandmediamuseum.org.uk/autochromes-the-dawn-of-colour-photography/",
      "kind": "Museum process history",
      "finding": "Commercial autochrome plates began in 1907. Early twentieth-century photography therefore cannot be reduced to monochrome.",
      "checked": "2026-10-29"
    },
    {
      "id": "S06",
      "title": "V&A · Art Nouveau",
      "url": "https://www.vam.ac.uk/collections/art-nouveau",
      "kind": "Museum collection",
      "finding": "Organic curves and tendrils are associated with a movement from the early 1890s to the First World War, rather than all of the nineteenth century.",
      "checked": "2026-10-29"
    },
    {
      "id": "S07",
      "title": "V&A · An introduction to Art Deco",
      "url": "https://www.vam.ac.uk/articles/an-introduction-to-art-deco",
      "kind": "Museum history",
      "finding": "The 1925 Paris exposition is an important reference point. Geometry, modernity and varied international influences complicate the familiar gold-and-black shorthand.",
      "checked": "2026-10-29"
    },
    {
      "id": "S08",
      "title": "MoMA · Jacob Lawrence, Migration Series",
      "url": "https://www.moma.org/collection/works/78539",
      "kind": "Object record / curatorial text",
      "finding": "The 1940–41 series tells the Great Migration through repeated colours, angular forms and narrative panels. Its making date differs from the earlier events depicted.",
      "checked": "2026-10-29"
    },
    {
      "id": "S09",
      "title": "Smithsonian NMAH · Nature Boy / Lost April",
      "url": "https://americanhistory.si.edu/collections/object/nmah_663359",
      "kind": "Original recording object",
      "finding": "Capitol 15054 is a shellac 78 rpm disc with a 1948 release date: a closer material reference for the Cole stop than a later LP-cover stereotype.",
      "checked": "2026-10-29"
    },
    {
      "id": "S10",
      "title": "MoMA · Reid Miles",
      "url": "https://www.moma.org/artists/38897-reid-miles",
      "kind": "Designer / collection records",
      "finding": "The listed Blue Note sleeves run from 1957 through the 1960s; the label’s visual references should not all be backdated to 1948.",
      "checked": "2026-10-29"
    },
    {
      "id": "S11",
      "title": "V&A · A short history of the poster",
      "url": "https://www.vam.ac.uk/articles/a-short-history-of-the-poster",
      "kind": "Museum design history",
      "finding": "British psychedelic screenprinting and San Francisco lithography provide different production references for 1960s poster design.",
      "checked": "2026-10-29"
    },
    {
      "id": "S12",
      "title": "V&A Americas Foundation · Bonnie MacLean, 6 Days of Sound",
      "url": "https://vamaf.org/our-work/acquisitions/6-days-of-sound-designed-by-bonnie-maclean-1967/",
      "kind": "Dated poster / collection record",
      "finding": "A named designer, San Francisco concert context and 1967 date anchor a psychedelic reference more precisely than a generic hippie mood board.",
      "checked": "2026-10-29"
    },
    {
      "id": "S13",
      "title": "Kodak · Chronology of motion-picture film",
      "url": "https://www.kodak.com/en/motion/page/chronology-of-film/",
      "kind": "Manufacturer history",
      "finding": "Super 8 became commercially available in 1965. It can inform a later home-movie look, but cannot stand in for all earlier film.",
      "checked": "2026-10-29"
    },
    {
      "id": "S14",
      "title": "National Portrait Gallery · Jamie Reid",
      "url": "https://www.npg.org.uk/collections/search/person/mp68119/jamie-reid?role=art",
      "kind": "Artist / object history",
      "finding": "The 1976–77 Sex Pistols sleeves document torn graphics, cut-up lettering and a specific British punk context.",
      "checked": "2026-10-29"
    },
    {
      "id": "S15",
      "title": "Design Museum · Memphis",
      "url": "https://designmuseum.org/memphis",
      "kind": "Museum design history",
      "finding": "The Milan collective debuted in 1981, using conspicuous colour, patterned laminates and deliberately unconventional forms.",
      "checked": "2026-10-29"
    },
    {
      "id": "S16",
      "title": "V&A · Staying Power: photographs of Black British experience",
      "url": "https://www.vam.ac.uk/articles/staying-power-photographs-of-black-british-experience",
      "kind": "Photographic collection / biographies",
      "finding": "Named photographers including Normski, Jennie Baptiste and Syd Shelton provide situated music, fashion and community perspectives across several decades.",
      "checked": "2026-10-29"
    },
    {
